<Window x:Class="CafConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频转 CAF" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave" Closing="OnClosing">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="54" Height="54" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="0,0,13,0">
                    <TextBlock Text="♫" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="音频转 CAF" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="MP3 / MP4 / 音频视频文件转换为 iPhone CAF 铃声" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" />
                <Button Content="⚙ 设置" Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="540"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="9">
                        <Button Style="{StaticResource PrimaryButton}" Content="＋ 添加文件" Click="OnAddFilesClick" />
                        <Button Content="选择全部" Command="{Binding SelectAllCommand}" />
                        <Button Content="删除选中" Command="{Binding RemoveSelectedCommand}" />
                        <Button Content="清空列表" Command="{Binding ClearCommand}" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" AlternationCount="2"
                                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="✓" Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="150" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="54" />
                                <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="88" />
                                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeText}" Width="72" />
                                <DataGridTextColumn Header="音频格式" Binding="{Binding AudioFormat}" Width="160" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="85" />
                                <DataGridTemplateColumn Header="进度" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="10"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="输出路径" Binding="{Binding OutputDisplay}" Width="220" />
                                <DataGridTemplateColumn Header="操作" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="取消" Padding="7,3" Command="{Binding CancelCommand}" />
                                    <Button Content="打开" Padding="7,3" Click="OnOpenItemClick" />
                                    <Button Content="复制错误" Padding="7,3" Click="OnCopyErrorClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                    <Button Content="删除" Padding="7,3" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="⇩" FontSize="45" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                            <TextBlock Text="将 MP3、MP4 或其他媒体文件拖到这里" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5" />
                            <TextBlock Text="支持批量转换，所有文件仅在本机处理" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#CC426FD6" BorderBrush="#A9C4FF" BorderThickness="2" CornerRadius="10" Margin="10" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="松开鼠标即可添加文件" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="文件不会离开这台电脑" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel" Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="17">
                    <TextBlock Text="转换设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="预设" Foreground="{DynamicResource SecondaryText}" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                    <Border Background="#33F3B74B" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,10">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowBarkNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><TextBlock Text="转换为 44.1 kHz、16 位 PCM、单声道 CAF，并限制为 29 秒。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="iPhone 通知音建议少于 30 秒，当前将输出 29 秒。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="采样率" Foreground="{DynamicResource SecondaryText}"/><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" IsEnabled="{Binding IsCustomPreset}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="声道" Foreground="{DynamicResource SecondaryText}"/><ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding Channels}" IsEnabled="{Binding IsCustomPreset}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="立体声"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="1"><Setter Property="Text" Value="单声道"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    </Grid>
                    <TextBlock Text="开始时间" Foreground="{DynamicResource SecondaryText}"/><TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTrimEnabled}" />
                    <TextBlock Text="输出时长" Foreground="{DynamicResource SecondaryText}"/><TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDurationEnabled}" />
                    <TextBlock Text="结束位置" Foreground="{DynamicResource SecondaryText}"/><TextBox Text="{Binding EndTimeText, Mode=OneWay}" IsReadOnly="True" />
                    <CheckBox Content="保留完整时长" IsChecked="{Binding KeepFullDuration}" IsEnabled="{Binding IsCustomPreset}" />
                    <CheckBox Content="音量标准化（loudnorm）" IsChecked="{Binding NormalizeVolume}" />
                    <StackPanel IsEnabled="{Binding IsCustomPreset}"><CheckBox Content="淡入" IsChecked="{Binding FadeIn}"/><TextBox Text="{Binding FadeInSeconds}" ToolTip="淡入秒数"/><CheckBox Content="淡出" IsChecked="{Binding FadeOut}"/><TextBox Text="{Binding FadeOutSeconds}" ToolTip="淡出秒数"/></StackPanel>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,3,0,8" />
                    <Separator Margin="0,8" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="输出位置" FontWeight="SemiBold" Margin="0,4,0,5"/>
                    <RadioButton Content="输出到源文件目录" IsChecked="{Binding OutputToSource}" />
                    <RadioButton Content="输出到指定目录" IsChecked="{Binding OutputToCustom}" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="选择…" Click="OnChooseOutputClick"/><TextBox Text="{Binding OutputDirectory}" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
                    <CheckBox Content="覆盖已有文件（不逐个询问）" IsChecked="{Binding OverwriteExisting}" />
                    <TextBlock Text="默认自动重命名：名称 (1).caf" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,8" />
                    <TextBlock Text="并发转换数量（1–4）" Foreground="{DynamicResource SecondaryText}"/><ComboBox ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding Concurrency}"/>
                    <TextBlock Text="FFmpeg" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{Binding FfmpegStatus}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/><Button Content="选择 FFmpeg…" Click="OnChooseFfmpegClick" HorizontalAlignment="Left"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="开始转换" Command="{Binding StartCommand}" Padding="23,10" />
                <Button Content="取消全部" Command="{Binding CancelAllCommand}" Padding="18,10" />
                <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}" />
                <Button Content="查看日志" Command="{Binding OpenLogCommand}" />
                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource SuccessBrush}" Margin="14,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="3,8,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding TotalProgress, Mode=OneWay}" Height="7" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}" Margin="12,0,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Window>
