<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#111318" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1A1E26" />
    <SolidColorBrush x:Key="ControlBackground" Color="#252B36" />
    <SolidColorBrush x:Key="PrimaryText" Color="#F4F7FB" />
    <SolidColorBrush x:Key="SecondaryText" Color="#AAB4C5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#343C4A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#74A0FF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F3B74B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B77" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#48C78E" />
</ResourceDictionary>
